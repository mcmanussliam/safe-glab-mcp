{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mcmanussliam/safe-glab-mcp/blob/main/safe-glab.schema.json",
  "title": "safe-glab-mcp config",
  "type": "object",
  "required": ["gitlab", "defaults", "projects"],
  "additionalProperties": false,
  "properties": {
    "gitlab": {
      "type": "object",
      "required": ["baseUrl", "tokenKey"],
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Base URL of your GitLab instance, e.g. https://gitlab.com"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1,
          "description": "Name used to look up the token — checked in the OS keychain first, then as an environment variable"
        }
      }
    },
    "defaults": {
      "type": "object",
      "required": ["protectedBranches", "allowedMergeRequestTargetBranches", "maxRepositoryFileBytes"],
      "additionalProperties": false,
      "properties": {
        "protectedBranches": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Branch name patterns (glob-style) that cannot be pushed to or used as MR source branches"
        },
        "allowedMergeRequestTargetBranches": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Branch name patterns (glob-style) that merge requests may target"
        },
        "maxRepositoryFileBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum file size in bytes that repository file reads will return"
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "permissions"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.\\-]+(?:\\/[A-Za-z0-9_.\\-]+)+$",
            "description": "GitLab project path in namespace/project form, e.g. platform/api"
          },
          "permissions": {
            "type": "object",
            "required": ["branches", "mergeRequests", "issues", "metadata", "pipelines", "repository"],
            "additionalProperties": false,
            "properties": {
              "branches": {
                "type": "object",
                "required": ["list", "get", "create"],
                "additionalProperties": false,
                "properties": {
                  "list": { "type": "boolean" },
                  "get": { "type": "boolean" },
                  "create": { "type": "boolean" }
                }
              },
              "mergeRequests": {
                "type": "object",
                "required": ["list", "get", "create", "comment"],
                "additionalProperties": false,
                "properties": {
                  "list": { "type": "boolean" },
                  "get": { "type": "boolean" },
                  "create": { "type": "boolean" },
                  "comment": { "type": "boolean" }
                }
              },
              "issues": {
                "type": "object",
                "required": ["list", "get", "create", "update", "delete", "comment"],
                "additionalProperties": false,
                "properties": {
                  "list": { "type": "boolean" },
                  "get": { "type": "boolean" },
                  "create": { "type": "boolean" },
                  "update": { "type": "boolean" },
                  "delete": { "type": "boolean" },
                  "comment": { "type": "boolean" }
                }
              },
              "metadata": {
                "type": "object",
                "required": ["labels", "milestones", "users"],
                "additionalProperties": false,
                "properties": {
                  "labels": { "type": "boolean" },
                  "milestones": { "type": "boolean" },
                  "users": { "type": "boolean" }
                }
              },
              "pipelines": {
                "type": "object",
                "required": ["list", "get", "jobs"],
                "additionalProperties": false,
                "properties": {
                  "list": { "type": "boolean" },
                  "get": { "type": "boolean" },
                  "jobs": { "type": "boolean" }
                }
              },
              "repository": {
                "type": "object",
                "required": ["readFiles", "readTree"],
                "additionalProperties": false,
                "properties": {
                  "readFiles": { "type": "boolean" },
                  "readTree": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  }
}
